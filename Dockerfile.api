# API image (монорепо). Копия в корне `Dockerfile` — Render ищет именно его.
FROM node:22-alpine AS deps
WORKDIR /src
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY --from=deps /src/node_modules ./node_modules
COPY apps/api ./apps/api
RUN npm run build -w=@finance/api

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci --omit=dev -w=@finance/api
COPY apps/api/drizzle ./apps/api/drizzle
COPY --from=build /src/apps/api/dist ./apps/api/dist
COPY deploy/docker-entrypoint-api.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
WORKDIR /app/apps/api
EXPOSE 3000
ENTRYPOINT ["/entrypoint.sh"]
