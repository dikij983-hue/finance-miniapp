# Скопируйте в .env рядом с docker-compose.yml

BOT_TOKEN=000000:xxx
JWT_SECRET=минимум-16-символов-случайная-строка
POSTGRES_PASSWORD=надёжный-пароль-бд

# Порт на хосте (HTTP). Для Telegram Mini App снаружи нужен HTTPS — см. DEPLOY.md
HTTP_PORT=8080

# Опционально: внешний API + агент
# API_BEARER_KEY=
# API_USER_TELEGRAM_ID=123456789
# OPENAI_API_KEY=
