# Copy to apps/api/.env and apps/web/.env.local as needed
#
# --- Render API (только локально, деплой/CLI): скопируйте .env.render.example → .env.render и вставьте ключ в одну строку.
#     Пример: cp .env.render.example .env.render

# apps/api
DATABASE_URL=postgresql://user:pass@localhost:5432/finance_miniapp
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
JWT_SECRET=change-me-to-long-random-string
API_BEARER_KEY=optional-readonly-api-key-for-external-tools
# Telegram numeric user id — владелец данных для /ext/* (один пользователь)
API_USER_TELEGRAM_ID=123456789
OPENAI_API_KEY=optional-for-agent-insights

# apps/web (Vite) — public URL of API for browser
VITE_API_URL=http://localhost:3000
